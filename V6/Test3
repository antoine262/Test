<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:jaxb="https://jakarta.ee/xml/ns/jaxb"
           xmlns:meta="urn:example:custom-meta"
           jaxb:version="3.0"
           jaxb:extensionBindingPrefixes="meta">

  <xs:element name="person">
    <xs:complexType>
      <xs:sequence>

        <!-- 2 balises -> @CustomProperties({...}) sur le champ -->
        <xs:element name="firstName" type="xs:string">
          <xs:annotation>
            <xs:appinfo>
              <meta:jsonMeta key="title" value="Prenom"/>
              <meta:jsonMeta key="description" value="Le prenom"/>
            </xs:appinfo>
          </xs:annotation>
        </xs:element>

        <!-- 1 balise -> @CustomProperty(...) sur le champ -->
        <xs:element name="lastName" type="xs:string">
          <xs:annotation>
            <xs:appinfo>
              <meta:jsonMeta key="title" value="Nom"/>
            </xs:appinfo>
          </xs:annotation>
        </xs:element>

      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>


